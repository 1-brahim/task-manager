<%- include('_header') %>
<div class="card" style="max-width:400px;margin:auto">
<h2><%= mode === 'login' ? 'Login' : 'Create account' %></h2>
<% if (error) { %><div class="err"><%= error %></div><% } %>
<form method="post" action="/<%= mode %>">
<% if (mode === 'register') { %><label>Name</label><input name="name"><% } %>
<label>Email</label><input name="email" type="email"><label>Password</label><input name="password" type="password">
<button>Submit</button></form></div>
<%- include('_footer') %>
